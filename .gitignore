@"
# Python environment
venv/
.venv/
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/

# FastF1 cache (large, regenerated automatically)
f1_cache/

# Generated data (regenerated by running the pipeline)
f1_data_2026/
f1_data_historical/

# Model files (regenerated by apex_train.py)
*.pkl
*.pkl.gz

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
"@ | Out-File -FilePath .gitignore -Encoding utf8